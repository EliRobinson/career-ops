# career-ops web — self-contained ignore (does not touch core root .gitignore)
/node_modules
/.next*
/out
/dist
/.turbo
*.tsbuildinfo
next-env.d.ts
.env*.local
.DS_Store

# local QA artifacts (screenshots live in the workspace root, outside this tree)
.playwright-mcp/

# agent session memory — internal notes, never in the public repo
.claude/

# next dev (Next 16) regenerates these on every run — see
# node_modules/next/dist/server/lib/generate-agent-files.js. Machine-local
# scaffolding, not project content; keep the tree clean instead of committing
# a file nobody hand-edits.
/AGENTS.md
/CLAUDE.md
